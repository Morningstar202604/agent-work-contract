{
  "version": 1,
  "updated": "YYYY-MM-DD",
  "policy": "本机凭据库，永不提交、不外传；轮换先改提供商再改本文件",
  "platforms": {
    "github": {
      "api_base": "https://api.github.com",
      "auth": { "scheme": "bearer", "header": "Authorization" },
      "accounts": {
        "your-account": {
          "env": "GITHUB_TOKEN_YOUR_ACCOUNT",
          "token": "<FILL_ME>",
          "status": "unchecked",
          "checked": null,
          "consumers": [],
          "default": true
        }
      }
    },
    "gitee": {
      "api_base": "https://gitee.com/api/v5",
      "auth": { "scheme": "query", "param": "access_token" },
      "accounts": {
        "your-account": {
          "env": "GITEE_TOKEN_YOUR_ACCOUNT",
          "token": "<FILL_ME>",
          "status": "unchecked",
          "checked": null,
          "consumers": []
        }
      }
    }
  },
  "rotation": {
    "advice": "90 天轮换一次；泄露立即吊销",
    "expiry_watch": []
  }
}
